{
  "name": "minimi-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A chat agent with one tool (web search), built around time-aware answers and cross-session recall.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "chrono-node": "^2.7.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
