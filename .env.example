# Required. Gemini key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required. Tavily key (free tier is enough): https://tavily.com
TAVILY_API_KEY=

# Optional. Any Gemini model id. The default alias tracks the current Flash model.
MODEL=gemini-3.5-flash
# Optional. minimal | low | medium | high. Lower = faster answers, shallower reasoning.
THINKING_LEVEL=
PORT=3000
# Where conversation logs (JSONL) are stored.
DATA_DIR=data
# Set to 1 to let the API accept a fake clock ({"now": "2026-11-15T09:00:00Z"}) for testing.
ALLOW_NOW_OVERRIDE=0
